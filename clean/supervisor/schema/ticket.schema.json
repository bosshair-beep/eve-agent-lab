{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eve-agent-lab.local/schema/ticket.schema.json",
  "title": "CLEAN_VI_MIGRATION ticket state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ticket_id",
    "title",
    "phase",
    "status",
    "scope",
    "created_at",
    "updated_at",
    "audit_revisits_used",
    "patch_attempts_used",
    "verification_runs_used",
    "subagent_invocations_used",
    "max_audit_revisits",
    "max_patch_attempts",
    "max_verification_runs",
    "max_subagent_invocations",
    "current_failure_signature",
    "failure_signature_history",
    "new_evidence_since_last_attempt",
    "measurable_progress",
    "files_allowed",
    "files_changed",
    "tests_required",
    "tests_executed",
    "tests_passed",
    "tests_failed",
    "runtime_touched",
    "db_touched",
    "provider_touched",
    "infra_touched",
    "auditor_status",
    "implementer_status",
    "verifier_status",
    "supervisor_required",
    "supervisor_decision",
    "stop_reason",
    "report_path",
    "evidence_path"
  ],
  "properties": {
    "ticket_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "phase": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "AUDITING",
        "ROOT_CAUSE_FOUND",
        "READY_TO_PATCH",
        "IMPLEMENTING",
        "VERIFYING",
        "SUPERVISOR_REVIEW",
        "CLOSED",
        "REJECTED",
        "CANCELLED",
        "BLOCKED_EXTERNAL",
        "BLOCKED_SUPERVISOR"
      ]
    },
    "scope": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "audit_revisits_used": { "type": "integer", "minimum": 0 },
    "patch_attempts_used": { "type": "integer", "minimum": 0 },
    "verification_runs_used": { "type": "integer", "minimum": 0 },
    "subagent_invocations_used": { "type": "integer", "minimum": 0 },
    "max_audit_revisits": { "type": "integer", "minimum": 0 },
    "max_patch_attempts": { "type": "integer", "minimum": 0 },
    "max_verification_runs": { "type": "integer", "minimum": 0 },
    "max_subagent_invocations": { "type": "integer", "minimum": 0 },
    "current_failure_signature": { "type": ["object", "null"] },
    "failure_signature_history": {
      "type": "array",
      "items": { "type": "string" }
    },
    "new_evidence_since_last_attempt": { "type": "boolean" },
    "measurable_progress": { "type": "boolean" },
    "files_allowed": { "type": "array", "items": { "type": "string" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "tests_required": { "type": "array" },
    "tests_executed": { "type": "array" },
    "tests_passed": { "type": "array" },
    "tests_failed": { "type": "array" },
    "runtime_touched": { "type": "boolean" },
    "db_touched": { "type": "boolean" },
    "provider_touched": { "type": "boolean" },
    "infra_touched": { "type": "boolean" },
    "auditor_status": { "type": "string" },
    "implementer_status": { "type": "string" },
    "verifier_status": { "type": "string" },
    "supervisor_required": { "type": "boolean" },
    "supervisor_decision": { "type": ["string", "object", "null"] },
    "stop_reason": { "type": ["string", "null"] },
    "report_path": { "type": ["string", "null"] },
    "evidence_path": { "type": ["string", "null"] }
  }
}
